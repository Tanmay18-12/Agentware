# --- MeetingPilot runtime defaults (offline, zero secrets) ---
MOCK_MODE=1
LLM_MODE=cassette
DRY_RUN=0

# Owner / mailbox identity used by the mock providers
OWNER_EMAIL=owner@example.com
OWNER_NAME=Tanmay

# Paths (relative to repo root)
SANDBOX_DIR=sandbox
TRACES_DIR=traces
CONFIG_PATH=config/prefs.yaml
DATABASE_PATH=sandbox/meetingpilot.db

# Dashboard
HOST=127.0.0.1
PORT=8000

# --- Optional: real providers (mock stays the default) ---
# docker compose up -d  starts Mailpit (SMTP 1025 / API 8025) and Radicale (CalDAV 5232).
# MAIL_PROVIDER=mailpit       # mock | imap | mailpit
# CALENDAR_PROVIDER=caldav    # mock | caldav
# IMAP_HOST=127.0.0.1
# IMAP_PORT=1143
# IMAP_USER=meetingpilot
# IMAP_PASSWORD=meetingpilot
# IMAP_SSL=0
# IMAP_MAILBOX=INBOX
# IMAP_DRAFTS_MAILBOX=Drafts
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=0
# SMTP_SSL=0
# MAIL_FROM=owner@example.com
# MAILPIT_URL=http://127.0.0.1:8025
# CALDAV_URL=http://127.0.0.1:5232/owner/
# CALDAV_USER=owner
# CALDAV_PASSWORD=owner
# CALDAV_CALENDAR=meetingpilot
# CALDAV_VERIFY_TLS=1

# --- Optional: live LLM (never commit a real key) ---
# LLM_MODE=live
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
